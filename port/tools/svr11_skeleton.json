{
 "version": 1,
 "source": "stock ch104 (male, the converters' template); generated by tools/svr11_skeleton.py",
 "space": {
  "units": "1 model unit = 10 cm (WWE '12+ are in cm: x 0.1)",
  "up": "-Y (the head is at negative Y)",
  "front": "-Z (the face and toes point to -Z)",
  "left": "+X is the character's left (l_ bones)",
  "origin": "the pelvis (root) at 0; the floor is the lowest vertex, about +9.4 on ch104 (no floor bone)",
  "rotation": "local euler radians r = (x, y, z), matrix Rz * Ry * Rx (column vectors); world = parent world * [R | t]",
  "bone_axis": "+X of a bone's local frame points along the bone: a child's t is (length, ~0, ~0) in the parent frame",
  "bind_pose": "A-pose: upper arms 15 deg below horizontal, elbows bent 20 deg forward (kote r.y = 0.349), thighs 15 deg out, fingers slightly curled; meshes are stored in this pose (bind = rest)"
 },
 "node_record": {
  "size": 80,
  "fields": "name char[16], t f32x3 +16, pad u32 +28, r f32x3 +32, pad u32 +44, parent s32 +48 (-1 / 0 = root), u32 x3 +52, bounding sphere f32x4 +64 (0 on stock bones)",
  "order": "parents come before children; the game finds bones by name (motion, face animation, physics), so a table may drop or add bones (stock tables run 92-140 nodes)"
 },
 "roles": {
  "root": "pelvis: the motion root (translation + rotation)",
  "motion": "the 21 bones the motion data (YMKs / YMBs) animates; axes = which local rotation axes the motion keys (xyz free; yz keeps the bone direction; xy and y are hinges)",
  "twist": "in-line roll segments (*_momo_x, *_ninoude_x, *_kote_x, *_kote_x2, kubi_x): not in the motion data, the game spreads the limb roll over them; stock skins weight the forearm / upper arm / thigh roll to them",
  "helper": "corrective bones (*_ninoude_m, *_kote_m, *_kata_m, *_sakotsu_m, *_mune_dummy, onaka): stock skins use them at the shoulders, elbows, chest and belly; a skin may leave them unweighted",
  "finger": "30 finger joints yubiFJ: F 0 thumb, 1 index, 2 middle, 3 ring, 4 pinky; J 0 base (parent te), 1, 2 (parent the previous joint); posed by hand shapes (tools/hand_tracks.py, finger_retarget.py)",
  "face": "face animation bones under atama (brows mayu_*, miken, lids mabuta, eye, meziri, cheeks hoho*, nose hana, mouth *kuchi*); l_eye / r_eye carry the eyeballs (yReflect meshes); weight the head to atama only and the face simply does not animate",
  "end": "end bones (tsumasaki = toes) are animated too (y hinge)"
 },
 "optional_bones": {
  "l_boin / r_boin": "breast sway bones under mune (divas: their tables drop the 8 *_m / *_mune_dummy helpers)",
  "kami_aNN[_JJ] / kami_bNN[_JJ]": "sway physics chains (hair, ponytails, ties, coats) under atama / kubi / mune: chain NN, joints _00.._04; the game simulates them by name",
  "k*, kl_*, kr_*": "contact points (ch192 only); not needed"
 },
