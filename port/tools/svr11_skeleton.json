 "mesh_rules": {
  "models": {
   "0x0": "body (skin yBumpMapSS + eyes yReflect + a few yDefault)",
   "0x2710": "hair / beard cards (yBumpMapSS)",
   "0x4e20": "eyelashes (yDefault)",
   "0x7530 / 0x7531 / 0x7532": "blood overlays (template copies; dropped when over the budget)"
  },
  "palette": "up to 20 bones per mesh: node index + 1 (s32; unused = -1); split a mesh when it needs more",
  "influences": "up to 4 per vertex; weight block count n = mesh +0x5C (1-4, the most any vertex of the mesh uses); the weights are vertex-major: per vertex n entries {u8 palette slot (255 = none), u8 0 x3, f32 weight}, summing to 1",
  "vertex": "28 bytes big-endian: position f32x3, normal f32x3, colour u32 ARGB (keep FFFFFFFF: alpha is drawn as opacity); uv f32x2 in their own array (v down, DirectX); indices u16 (so at most 65535 vertices per mesh)",
  "primitives": "triangle strips (prim 6), degenerate-joined; several strips per mesh allowed",
  "vertex_format": "mesh +0x8C, a per-material flag word (0-12 seen; not the block count): copy the template mesh's for that kind (skin 0, eyes 3, hair 4, lashes 0)",
  "shaders": {
   "skin": "yBumpMapSS: texDiffuse color, texNormal normal, texOcclusion Mk, texTilingMap noise",
   "eye": "yReflect: texDiffuse color, texCubeRefction cubemap, texRefctionReg color, texOcclusion Mk",
   "hair": "yBumpMapSS (the template hair mesh's parameters)",
   "lash": "yDefault: texDiffuse color"
  },
  "textures": {
   "0xc": "colour bundle: \"color\" RGBA DXT5, alpha = specular level (and the cut-out on hair / lash cards)",
   "0xa": "normal (DXT5), noise (template), Mk (DXT5: R bruise mask, G/B ambient occlusion, A spec mask), bloodhair* (template)",
   "mips": "full mip chains; a sheet without mips draws black in the game"
  },
  "budget": "per wrestler 768 KB of vertex memory = 192 pages of 4 KB; per mesh ceil(verts x (32 if 1 weight block else 44) / 4096) + ceil(indices x 2 / 4096) pages, over every model of the attire (model_budget.py); over 192 the match crashes on load - drop the blood overlays first (the game also does at mod load)",
  "from_template": "the node table (frames), hair / lash / eye parameter blocks, children 0xb, 0x28, 0x32, 0x50, 0x64, noise, cubemap, bloodhair textures, the blood overlays and the portrait 0xc8 / 0xc9 (256 x 256 DXT5) unless one is given",
  "pac": "EPK8 with one EMD group (entry names = attires); header +4 = index size 12 + 16 x entries, the group's count field = entries x 4 (wrong values crash the mount); children PACH, BPE-compressed",
  "pitfalls": [
   "vertex colour alpha 0 makes the skin invisible (force FF)",
   "the Mod Maker preview ignores the EPK8 header and the vertex alpha: a model can look fine there and still fail",
   "mesh +0x74 = the mesh's own index in the model"
  ]
 }
