{
 "version": 1,
 "targets": "tools/svr11_skeleton.json bone names",
 "compare": "case-insensitive, after stripping a namespace (text up to the last \":\" \"|\" \"/\") and a \"Bip01 \" / \"Bip001 \" prefix",
 "rules": {
  "spine": "hips -> root; the bones on the path from the hips to the one the clavicles (or upper arms) hang off: first -> koshi, last -> mune, any between fold into koshi; on the path from there to the head the first -> kubi",
  "many_to_one": "several source bones on one 2011 bone (two neck bones, a calf twist): weights add up; the joint position comes from the one nearest the root",
  "above_hips": "bones above the hips (rig root, armature) stay unmapped; weights on them go to root",
  "twist": "bones named *twist* / *roll* (or Rigify '.001' arm / thigh segments) -> the twist bone of their segment: upper arm -> ninoude_x, forearm -> kote_x (a second one -> kote_x2), thigh -> momo_x, neck -> kubi_x; calf twists fold into sune",
  "fold": "an unmapped bone adds its weights to its nearest mapped ancestor (hair / skirt / coat chains, props, metacarpals, finger ends, extra toes, IK / control bones that deform)",
  "breast": "breast bones -> l_boin / r_boin when the template table has them (a diva template), else fold into mune",
  "fingers": "2011 has 3 joints per finger: a 4th (Mixamo *4, an end bone) folds into joint 3; metacarpals fold into the hand",
  "eyes": "eye bones -> l_eye / r_eye (eyeball meshes rigid on them)",
  "face": "no generic face mapping: the head weights go to atama and the face does not animate (WWE Biped face bones share 2011's names and map 1:1)",
  "min_hits": 8
 },
