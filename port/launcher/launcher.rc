// WWE SmackDown vs. Raw 2011 - PC port launcher: icon and version information.
// The icon is the game's own (its Xbox 360 title image, assets/svr2011.ico).
// Constants are spelled out so no SDK header is needed:
//   VS_VERSION_INFO = 1, VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1.

#ifdef SVR2011_ICON   /* assets/svr2011.ico, made by tools/make_icon.py */
1 ICON "../assets/svr2011.ico"
#endif

1 VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "WWE SmackDown vs. Raw 2011 PC Port Launcher"
            VALUE "FileVersion",      "1.0"
            VALUE "InternalName",     "svr2011_launcher"
            VALUE "OriginalFilename", "SvR2011 Launcher.exe"
            VALUE "ProductName",      "WWE SmackDown vs. Raw 2011 PC Port Launcher"
            VALUE "ProductVersion",   "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The application manifest (Common Controls 6, from the #pragma in the source)
// is generated and embedded by the build (/MANIFEST:EMBED).
