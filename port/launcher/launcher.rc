// WWE SmackDown vs. Raw 2011 - PC port launcher: icon and version information.
// The icon is the game's own (its Xbox 360 title image, assets/svr2011.ico).
// Constants are spelled out so no SDK header is needed:
//   VS_VERSION_INFO = 1, VOS_NT_WINDOWS32 = 0x40004, VFT_APP = 1.

#ifdef SVR2011_ICON   /* assets/svr2011.ico, made by tools/make_icon.py */
1 ICON "../assets/svr2011.ico"
#endif

#include "version_info.h"   /* (generated from VERSION.txt by CMakeLists.txt) */
/* (also the Mod Maker's: SVR2011_RC_MODMAKER from CMakeLists.txt) */
#ifdef SVR2011_RC_MODMAKER
#define RC_DESCRIPTION "SvR2011 Mod Maker - mod editor for the WWE SmackDown vs. Raw 2011 PC Port"
#define RC_INTERNAL    "svr2011_modmaker"
#define RC_FILENAME    "SvR2011 Mod Maker.exe"
#elif defined(SVR2011_RC_UPDATER)
#define RC_DESCRIPTION "SvR2011 Updater - installs updates of the WWE SmackDown vs. Raw 2011 PC Port for its launcher"
#define RC_INTERNAL    "svr2011_updater"
#define RC_FILENAME    "SvR2011 Updater.exe"
#else
#define RC_DESCRIPTION "SvR2011 Launcher - installs, sets up and starts the WWE SmackDown vs. Raw 2011 PC Port"
#define RC_INTERNAL    "svr2011_launcher"
#define RC_FILENAME    "SvR2011 Launcher.exe"
#endif

1 VERSIONINFO
 FILEVERSION     SVR2011_VER_NUM
 PRODUCTVERSION  SVR2011_VER_NUM
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KaikoClanworth"
            VALUE "FileDescription",  RC_DESCRIPTION
            VALUE "FileVersion",      SVR2011_VER_STR
            VALUE "InternalName",     RC_INTERNAL
            VALUE "LegalCopyright",   "Copyright (C) 2026 KaikoClanworth. Fan-made PC port; WWE SmackDown vs. Raw 2011 belongs to its owners."
            VALUE "OriginalFilename", RC_FILENAME
            VALUE "ProductName",      "WWE SmackDown vs. Raw 2011 PC Port"
            VALUE "ProductVersion",   SVR2011_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// The application manifest (Common Controls 6, from the #pragma in the source)
// is generated and embedded by the build (/MANIFEST:EMBED).
