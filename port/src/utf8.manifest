<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- WWE SmackDown vs. Raw 2011 - PC port: the programs' code page is UTF-8
     (Windows 10 1903+). Narrow paths - std::filesystem::path::string(), fopen,
     toml++ and spdlog file names, CreateFileA - are then UTF-8, so a game folder
     with letters outside the PC's code page works: a folder named "oyun yüklü"
     lost its settings file (toml++ read the ANSI path as UTF-8: no settings, no
     GPU, a black screen) and a Cyrillic one crashed at start (path::string()
     threw). Merged into the linker's manifest (CMake: a .manifest source). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
