# ── Allow-list: only the port's own files are in this repository. ──
# Game data (disc image, extracted files, installs, saves, DLC) and the
# recompiled game code never are: players supply their own disc.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTORS.md
!/docs/
!/port/

# Inside port/: generated game code, the game's executable, builds, test runs
/port/generated/
/port/assets/*
!/port/assets/README.md
/port/out/
/port/runs/
/port/*.txt
!/port/CMakeLists.txt
/port/tools/__pycache__/
*.xex
*.iso
*.xiso
*.bik
*.pac
*.exe
*.dll
*.pdb
*.ico
*.log
__pycache__/
*.pyc
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store
